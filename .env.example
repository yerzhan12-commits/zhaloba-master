# Anthropic API (уже используется api/wizard.js)
ANTHROPIC_API_KEY=

# Vercel KV (уже используется api/feedback.js, api/admin.js, api/_lib/payments.js)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Пароль для /api/admin (просмотр лога обращений и отзывов)
ADMIN_PASSWORD=

# Текущий МРП (месячный расчётный показатель) в тенге — используется для
# точного расчёта порогов 1600×МРП (банкротство) и 1000×МРП (согласие
# супруга на банковский заём) в api/_lib/thresholds.js. Тот же паттерн, что
# в bankrot-master — МЕНЯЕТСЯ РАЗ В ГОД вместе с республиканским бюджетом,
# обновлять значение при смене года, деплой кода не нужен. Если не задать —
# промпт сам аккуратно откажется называть конкретную сумму в тенге.
MRP_KZT=

# --- Эквайринг BCC (api/_lib/bcc.js) ---
# Идентификатор терминала торговца, выдаёт банк при подключении.
# Тестовое значение из документации BCC: 88888881
BCC_TERMINAL=

# Идентификатор торговца, выдаёт банк.
BCC_MERCHANT=

# Имя торговца ЗАГЛАВНЫМИ латинскими буквами, как согласовано с банком.
BCC_MERCH_NAME=

# Ключ для подписи P_SIGN (HMAC-SHA1), в HEX. Тестовый ключ из документации
# BCC: 6BB0AC02E47BDF73D98FEB777F3B5294 — для боевого режима банк выдаст свой.
BCC_MAC_KEY=

# URL платёжного шлюза (POST-эндпоинт, куда браузер клиента отправляет
# форму оплаты и куда сервер стучится за проверкой статуса TRTYPE=90).
# Тестовый: https://test3ds.bcc.kz:5445/cgi-bin/cgi_link
# Боевой уточнить у банка при подключении.
BCC_GATEWAY_URL=

# Часовой пояс торговца, как ожидает банк в поле MERCH_GMT.
# "0" — подтверждённое тестовое значение; для боевого мерчанта уточнить у банка.
BCC_MERCH_GMT=0
